# Application
APP_NAME=capitol-trades
ENV=development
DEBUG=True

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/capitol_trades

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Bright Data API
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
BRIGHT_DATA_ZONE=your_zone_name

# Logging
LOG_LEVEL=INFO
